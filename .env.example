# Copy to .env.local and fill in. .env.local is git-ignored.
ANTHROPIC_API_KEY=

# Live shared DuckDB (optional). Server-only: never prefix these with NEXT_PUBLIC_.
MOTHERDUCK_TOKEN=
KORI_MD_DATABASE=kori

# Optional
# KORI_CUSTOMER=CUST04414   # the demo customer
# KORI_EFFORT=low           # Claude Opus 5.5 effort: low | medium | high (low keeps answers fast)
# KORI_DEMO_MODE=auto       # on = force prepared demo; auto = fall back on no key/model failure; off = require Claude
# KORI_HISTORY_SECRET=      # optional history-signing key; ANTHROPIC_API_KEY is used when present

# Tests only: KORI_DB_PATH=/absolute/path/to/a/temp-copy.duckdb and KORI_DB_WRITABLE=1
# Never enable writable test mode against db/kori.duckdb or in Vercel.
